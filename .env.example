# ─────────────────────────────────────────────────────────────────────────────
# DriveReady Florida · Narración bilingüe con Fish Audio
#
# Fish Audio SOLO se usa en LOCAL, desde los scripts de Node (scripts/fish/).
# El navegador NUNCA llama a Fish Audio y NUNCA recibe estas credenciales.
# Copia este archivo a `.env` y rellena tus valores. `.env` NO se sube al repo.
# ─────────────────────────────────────────────────────────────────────────────

# API key privada. Se obtiene en https://fish.audio/go-api
FISH_API_KEY=

# Modelo TTS. IMPORTANTE: la API recibe el modelo en la CABECERA HTTP `model`,
# no dentro del cuerpo. Valores aceptados por la API: s1 | s2-pro (recomendado).
FISH_TTS_MODEL=s2-pro

# Reference ID de la VOZ inglesa (ID del modelo de voz en Fish Audio).
# No es un nombre de voz ni una ruta de archivo.
FISH_VOICE_EN_REFERENCE_ID=

# Reference ID de la VOZ española.
FISH_VOICE_ES_REFERENCE_ID=

# Formato de salida y calidad.
FISH_AUDIO_FORMAT=mp3
FISH_MP3_BITRATE=128
FISH_SAMPLE_RATE=44100

# Controles de gasto (obligatorios para evitar consumos accidentales).
# El catálogo completo son 200 narraciones y ~124.000 bytes de entrada.
FISH_MAX_REQUESTS=250
FISH_MAX_INPUT_BYTES=400000
FISH_MAX_ESTIMATED_USD=5

# Tarifa OPCIONAL para estimar el coste (USD por millón de caracteres).
# Si se deja vacío, el coste se reporta como DESCONOCIDO: no se inventan precios.
FISH_PRICE_PER_MILLION_CHARS=
