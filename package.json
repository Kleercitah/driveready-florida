{
  "name": "driveready-florida",
  "version": "1.0.0",
  "private": true,
  "description": "DriveReady Florida — plataforma de estudio para el Florida Class E Knowledge Exam.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
