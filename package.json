    "voices:generate": "node scripts/fish/generateAudio.js",
    "voices:validate": "node scripts/fish/validateAudio.js",
    "voices:all": "node scripts/fish/generateAudio.js --all"
  },
  "dependencies": {
    "lucide": "^0.454.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "vite": "^5.4.10",
